<?xml version="1.0" encoding="utf-8"?>
<!-- The "Split" mark for the splash window, and a second copy of the paths in
     spendwise_icon_foreground.xml on purpose.

     The two are drawn on different things. The icon foreground sits on the
     launcher's own ground and must never change with the system theme, so its
     colours are literals. This one sits on @color/spendwise_splash, which does
     change, and its kept band is the app's own near-white #E9E7E2 — which on
     the paper splash would be a 1.09:1 wash, i.e. an empty window with a thin
     clay thread in the middle of it. So its two fills are resources, answered
     per theme in values/ and values-night/. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.28"
        android:scaleY="1.28"
        android:translateX="14.3200"
        android:translateY="13.0400">
        <path
            android:fillColor="@color/spendwise_splash_kept"
            android:pathData="M24,8 L24,20 C24,34 10,40 10,56 L22,56 C22,40 36,34 36,20 L36,8 Z" />
        <path
            android:fillColor="@color/spendwise_splash_spent"
            android:pathData="M36,8 L36,20 C36,34 49,40 49,56 L52,56 C52,40 39,34 39,20 L39,8 Z" />
    </group>
</vector>
